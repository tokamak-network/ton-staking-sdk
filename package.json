{
  "name": "ton-staking-sdk",
  "version": "0.0.1",
  "description": "This is an SDK that allows you to easily use the functions of the TON staking contract.",
  "main": "index.js",
  "scripts": {
    "build": "rm -fr dist/* && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && ./fixup.sh"
  },
  "keywords": [],
  "author": "zena@tokamak.network",
  "license": "ISC",
  "exports": {
    ".": {
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "type": "module",
  "files": [
    "dist/*",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "util": "^0.12.5",
    "viem": "^2.22.21",
    "winston": "^3.17.0"
  },
  "peerDependencies": {
    "typescript": "^5.7.3"
  },
  "directories": {
    "example": "examples",
    "test": "tests"
  }
}
