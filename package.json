{
  "name": "@tokamak-network/ton-staking-sdk",
  "version": "0.0.19",
  "description": "This is an SDK that allows you to easily use the functions of the TON staking contract.",
  "main": "dist/cjs/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/mjs/index.js",
  "scripts": {
    "test": "npx tsx",
    "build:module": "tsc --project tsconfig.json",
    "build:main": "tsc --build tsconfig.cjs.json",
    "build": "rm -fr dist/* && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && ./fixup.sh"
  },
  "keywords": [],
  "author": "zena@tokamak.network",
  "license": "ISC",
  "exports": {
    ".": {
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "type": "module",
  "files": [
    "dist/*",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^22.13.1",
    "dotenv": "^16.4.7",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "viem": "^2.22.21"
  },
  "directories": {
    "test": "tests"
  }
}